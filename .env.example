# ═══════════════════════════════════════════════════════════════
# PILLAR — Standalone Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in real values before running.
# eSANGGUNI is fully self-contained — no eSANGGUNI backend required.
# ═══════════════════════════════════════════════════════════════

# ── Required: LLM API ─────────────────────────────────────────
# OpenRouter API key (OpenAI-compatible endpoint)
OPENROUTER_API_KEY=your-api-key-here

# LLM model (default: qwen/qwen3-235b-a22b)
LLM_MODEL=qwen/qwen3-235b-a22b

# ── Optional: LightRAG Knowledge Graph ────────────────────────
# URL of the LightRAG service for semantic graph-based retrieval.
# If empty or unavailable, eSANGGUNI falls back to BM25 search only.
# LIGHTRAG_SERVICE_URL=http://lightrag-service:8020

# ── Optional: Email Notifications (SMTP via Nodemailer) ──────
# Used for user registration approval/rejection notifications.
# If not configured, users check status manually at /login.
# SMTP_HOST=smtp.your-email-provider.com
# SMTP_PORT=587
# SMTP_USER=noreply@bayanaihan.net
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@bayanaihan.net

# ── SQLite database path ──────────────────────────────────────
# Must match the volume mount in docker-compose.yml (/data).
DB_PATH=/data/esangguni.db

# ── Workshop session grouping ─────────────────────────────────
# All interactions during this session are grouped by this ID.
# Defaults to the current YYYY-MM-DD date if not set.
# Change this before each new workshop session.
WORKSHOP_SESSION_ID=2026-06-07-esangguni-standalone

# ── Workshop session display title ────────────────────────────
WORKSHOP_SESSION_TITLE=eSANGGUNI — Smart Legislation: AI for Local Government

# ── Public URLs (baked at Docker build time) ──────────────────
# These are passed as --build-arg in docker-compose.yml.
# For single-domain deployment, leave as relative paths:
NEXT_PUBLIC_ELLA_URL=/ella
NEXT_PUBLIC_OBRA_URL=/obra
NEXT_PUBLIC_YALA_URL=/yala
NEXT_PUBLIC_ESANGGUNI_URL=/
# For subdomain deployment, use full URLs:
# NEXT_PUBLIC_ELLA_URL=https://ella.esangguni.bayanaihan.net
# NEXT_PUBLIC_OBRA_URL=https://obra.esangguni.bayanaihan.net
# NEXT_PUBLIC_YALA_URL=https://yala.esangguni.bayanaihan.net
# NEXT_PUBLIC_ESANGGUNI_URL=https://esangguni.bayanaihan.net

# ── Next.js runtime ───────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0
